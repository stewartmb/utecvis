{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "id",
    "name",
    "image_url",
    "department",
    "email",
    "research_groups",
    "research_areas",
    "citations",
    "source_url",
    "retrieved_at"
  ],
  "properties": {
    "id": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4503599627370495
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "image_url": {
      "type": [
        "string",
        "null"
      ]
    },
    "department": {
      "type": [
        "string",
        "null"
      ]
    },
    "email": {
      "type": [
        "string",
        "null"
      ]
    },
    "research_groups": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "research_areas": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "citations": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "h_index": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "citation_source": {
      "type": [
        "string",
        "null"
      ]
    },
    "citation_source_url": {
      "type": [
        "string",
        "null"
      ]
    },
    "citation_retrieved_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "citation_window": {
      "enum": [
        "all",
        null
      ]
    },
    "citation_basis": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_url": {
      "type": "string",
      "pattern": "^https://cris\\.utec\\.edu\\.pe/es/persons/"
    },
    "retrieved_at": {
      "type": "string",
      "minLength": 1
    }
  }
}
